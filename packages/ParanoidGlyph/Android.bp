android_app {
    name: "ParanoidGlyph",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],

    static_libs: [
        "SettingsLib",
        "SettingsLibButtonPreference",
        "SettingsLibSettingsTheme",
        "SettingsLibSliderPreference",
        "androidx.activity_activity-ktx",
        "androidx.core_core-ktx",
        "androidx.fragment_fragment-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-service",
        "androidx.preference_preference",
        "com.google.android.material_material",
        "com.nothing.thirdparty-java",
    ],

    kotlincflags: ["-Xjvm-default=all"],

    asset_dirs: select(soong_config_variable("nothing_glyph", "device"), {
        "phone1": ["phone1/assets"],
        "phone2": ["phone2/assets"],
        "phone3a": ["phone3a/assets"],
        default: [],
    }),
    resource_dirs: select(soong_config_variable("nothing_glyph", "device"), {
        "phone1": [
            "res",
            "phone1/res",
        ],
        "phone2": [
            "res",
            "phone2/res",
        ],
        "phone3a": [
            "res",
            "phone3a/res",
        ],
        default: [],
    }),

    platform_apis: true,
    certificate: "platform",
    privileged: true,
    privapp_allowlist: "permissions/privapp_whitelist_co.aospa.glyph.xml",
    system_ext_specific: true,

    required: [
        "GlyphAdapter",
        "whitelist_co.aospa.glyph",
    ],
}

prebuilt_etc {
    name: "whitelist_co.aospa.glyph",
    system_ext_specific: true,
    sub_dir: "sysconfig",
    src: "permissions/whitelist_co.aospa.glyph.xml",
    filename_from_src: true,
}
