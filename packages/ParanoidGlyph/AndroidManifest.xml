<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="co.aospa.glyph"
    android:versionCode="2"
    android:versionName="2.0"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.ACCESS_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CONTROL_DEVICE_LIGHTS" />
    <uses-permission android:name="android.permission.MANAGE_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".GlyphApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:persistent="true"
        android:defaultToDeviceProtectedStorage="true"
        android:enableOnBackInvokedCallback="true"
        android:directBootAware="true">

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".services.CallReceiverService"
            android:permission="android.permission.READ_PHONE_STATE">
        </service>

        <service
            android:name=".services.ChargingMeterService">
        </service>

        <service
            android:name=".services.PowershareService">
        </service>

        <service
            android:name=".services.FlipToGlyphService">
        </service>

        <service
            android:name=".services.MusicVisualizerService">
        </service>

        <service
            android:name=".services.VolumeLevelService">
        </service>

        <service
            android:name=".services.NotificationService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.GlyphTileService"
            android:exported="true"
            android:label="@string/tile_glyph_label"
            android:icon="@drawable/ic_glyph"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.TorchTileService"
            android:exported="true"
            android:label="@string/tile_torch_label"
            android:icon="@drawable/ic_torch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.MusicVisualizerTileService"
            android:exported="true"
            android:label="@string/tile_music_visualizer_label"
            android:icon="@drawable/ic_graphic_eq_24dp"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".services.ThirdPartyService"
            android:exported="true">
            <intent-filter>
                <action android:name="co.aospa.glyph.services.ThirdPartyService" />
            </intent-filter>
        </service>

        <activity
            android:name=".tiles.TileActivity"
            android:exported="true"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_glyph" />
            <meta-data
                android:name="com.android.settings.summary"
                android:value="@string/settings_summary" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-115" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="top_level_personalize_category" />
            <meta-data
                android:name="com.android.settings.icon_color_scheme"
                android:value="blue" />
        </activity>

        <activity
            android:name=".ui.settings.CallAnimationSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="co.aospa.glyph.action.CALL_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.ChargingMeterSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="co.aospa.glyph.action.CHARGING_LEVEL_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.PowershareSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="co.aospa.glyph.action.POWERSHARE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.VolumeIndicatorSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="co.aospa.glyph.action.VOLUME_LEVEL_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.MusicVisualizerSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="co.aospa.glyph.action.MUSIC_VISUALIZER_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.ScheduleSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="co.aospa.glyph.action.SCHEDULE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.ScheduleHoursSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="co.aospa.glyph.action.SCHEDULE_HOURS_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.FlipToGlyphSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="co.aospa.glyph.action.FLIP_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.NotificationAnimationSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="co.aospa.glyph.action.NOTIFS_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.EssentialAppsSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="co.aospa.glyph.action.ESSENTIAL_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.AllowedAppsSettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="co.aospa.glyph.action.APPS_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>
</manifest>
