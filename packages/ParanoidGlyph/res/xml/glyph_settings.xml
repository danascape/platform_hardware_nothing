<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_title">

    <com.android.settingslib.widget.MainSwitchPreference
        android:defaultValue="false"
        android:key="glyph_enable"
        android:title="@string/pref_glyph_lights_title" />

    <com.android.settingslib.widget.BannerMessagePreference
        android:key="glyph_settings_quiet"
        android:title="@string/quiet_banner_title"
        settings:attentionLevel="normal"
        settings:isPreferenceVisible="false" />

    <PreferenceCategory
        android:key="glyph_settings_brightness_category"
        android:title="@string/pref_category_brightness">

        <com.android.settingslib.widget.SliderPreference
            android:dependency="glyph_enable"
            android:key="glyph_settings_brightness"
            android:title="@string/pref_brightness_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:dependency="glyph_enable"
            android:key="glyph_settings_auto_brightness"
            android:summary="@string/pref_auto_brightness_summary"
            android:title="@string/pref_auto_brightness_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="glyph_settings_alerts"
        android:title="@string/pref_category_alerts">

        <com.android.settingslib.PrimarySwitchPreference
            android:defaultValue="true"
            android:dependency="glyph_enable"
            android:key="glyph_settings_call_toggle"
            android:summary="@string/pref_call_animation_summary"
            android:title="@string/pref_call_animation_title">
            <intent android:action="co.aospa.glyph.action.CALL_SETTINGS" />
        </com.android.settingslib.PrimarySwitchPreference>

        <com.android.settingslib.PrimarySwitchPreference
            android:defaultValue="true"
            android:dependency="glyph_enable"
            android:key="glyph_settings_notifs_toggle"
            android:summary="@string/pref_notification_animation_summary"
            android:title="@string/pref_notification_animation_title">
            <intent android:action="co.aospa.glyph.action.NOTIFS_SETTINGS" />
        </com.android.settingslib.PrimarySwitchPreference>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="glyph_settings_indicators"
        android:title="@string/pref_category_indicators">

        <com.android.settingslib.PrimarySwitchPreference
            android:defaultValue="false"
            android:dependency="glyph_enable"
            android:key="glyph_settings_charging_level"
            android:summary="@string/pref_charging_meter_summary"
            android:title="@string/pref_charging_meter_title">
            <intent android:action="co.aospa.glyph.action.CHARGING_LEVEL_SETTINGS" />
        </com.android.settingslib.PrimarySwitchPreference>

        <com.android.settingslib.PrimarySwitchPreference
            android:defaultValue="false"
            android:dependency="glyph_enable"
            android:key="glyph_settings_charging_powershare"
            android:summary="@string/pref_powershare_summary"
            android:title="@string/pref_powershare_title">
            <intent android:action="co.aospa.glyph.action.POWERSHARE_SETTINGS" />
        </com.android.settingslib.PrimarySwitchPreference>

        <com.android.settingslib.PrimarySwitchPreference
            android:defaultValue="false"
            android:dependency="glyph_enable"
            android:key="glyph_settings_volume_level_toggle"
            android:summary="@string/pref_volume_indicator_summary"
            android:title="@string/pref_volume_indicator_title">
            <intent android:action="co.aospa.glyph.action.VOLUME_LEVEL_SETTINGS" />
        </com.android.settingslib.PrimarySwitchPreference>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="glyph_settings_gestures"
        android:title="@string/pref_category_gestures">

        <com.android.settingslib.PrimarySwitchPreference
            android:defaultValue="false"
            android:dependency="glyph_enable"
            android:key="glyph_settings_flip_toggle"
            android:summary="@string/pref_flip_to_glyph_summary"
            android:title="@string/pref_flip_to_glyph_title">
            <intent android:action="co.aospa.glyph.action.FLIP_SETTINGS" />
        </com.android.settingslib.PrimarySwitchPreference>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="glyph_settings_more"
        android:title="@string/pref_category_more">

        <Preference
            android:dependency="glyph_enable"
            android:key="glyph_settings_schedule"
            android:summary="@string/pref_schedule_summary"
            android:title="@string/pref_schedule_title">
            <intent android:action="co.aospa.glyph.action.SCHEDULE_SETTINGS" />
        </Preference>

        <com.android.settingslib.PrimarySwitchPreference
            android:defaultValue="false"
            android:dependency="glyph_enable"
            android:key="glyph_settings_music_visualizer_toggle"
            android:summary="@string/pref_music_visualizer_summary"
            android:title="@string/pref_music_visualizer_title">
            <intent android:action="co.aospa.glyph.action.MUSIC_VISUALIZER_SETTINGS" />
        </com.android.settingslib.PrimarySwitchPreference>

    </PreferenceCategory>

</PreferenceScreen>
