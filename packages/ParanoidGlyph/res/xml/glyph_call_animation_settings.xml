<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/pref_call_animation_title">

    <co.aospa.glyph.ui.preference.GlyphAnimationPreference
        android:key="glyph_settings_call_sub_preview"
        settings:badgeIcon="@drawable/ic_badge_call"
        android:selectable="false" />

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="glyph_settings_call_sub_toggle"
        android:title="@string/pref_call_animation_enable_title" />

    <PreferenceCategory
        android:key="glyph_settings_call_sub_animation_category"
        android:title="@string/pref_category_animation">

        <ListPreference
            android:defaultValue="@string/config_defaultCallAnimation"
            android:dependency="glyph_settings_call_sub_toggle"
            android:icon="@drawable/ic_animation_24dp"
            android:key="glyph_settings_call_sub_animations"
            android:summary="%s"
            android:title="@string/pref_call_animation_pattern_title" />

        <com.android.settingslib.widget.ButtonPreference
            android:dependency="glyph_settings_call_sub_toggle"
            android:icon="@drawable/ic_play_arrow_24dp"
            android:key="glyph_settings_call_sub_play"
            android:title="@string/pref_animation_play_title"
            settings:buttonPreferenceSize="large"
            settings:buttonPreferenceType="tonal" />

    </PreferenceCategory>

</PreferenceScreen>
