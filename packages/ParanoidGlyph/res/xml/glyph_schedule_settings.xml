<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/pref_schedule_title">

    <com.android.settingslib.widget.IllustrationPreference
        android:key="glyph_schedule_illustration"
        android:selectable="false"
        settings:lottie_rawRes="@raw/glyph_schedule_preview" />

    <PreferenceCategory
        android:key="glyph_schedule_category"
        android:title="@string/pref_category_timing">

        <ListPreference
            android:defaultValue="none"
            android:entries="@array/schedule_mode_entries"
            android:entryValues="@array/schedule_mode_values"
            android:key="glyph_schedule_mode"
            android:summary="%s"
            android:title="@string/pref_schedule_mode_title" />

        <Preference
            android:key="glyph_schedule_bedtime"
            android:summary="@string/pref_schedule_bedtime_summary"
            android:title="@string/pref_schedule_bedtime_title">
            <intent android:action="android.settings.ZEN_MODE_AUTOMATION_SETTINGS" />
        </Preference>

        <Preference
            android:key="glyph_schedule_hours"
            android:title="@string/pref_schedule_hours_title">
            <intent android:action="co.aospa.glyph.action.SCHEDULE_HOURS_SETTINGS" />
        </Preference>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="glyph_schedule_dnd"
        android:title="@string/pref_category_schedule_dnd">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="glyph_schedule_dnd_sync"
            android:summary="@string/pref_schedule_dnd_summary"
            android:title="@string/pref_schedule_dnd_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="glyph_schedule_battery_saver"
        android:title="@string/pref_category_schedule_battery_saver">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="glyph_schedule_battery_saver_sync"
            android:summary="@string/pref_schedule_battery_saver_summary"
            android:title="@string/pref_schedule_battery_saver_title" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="glyph_schedule_footer"
        android:title="@string/schedule_footer" />

</PreferenceScreen>
