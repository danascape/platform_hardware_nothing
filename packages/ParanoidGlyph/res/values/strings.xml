<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Name of this application. [CHAR LIMIT=32] -->
    <string name="app_label" translatable="false">Glyph Interface</string>

    <!-- Settings screen title, and the Settings homepage entry. [CHAR LIMIT=32] -->
    <string name="settings_title">Glyph Interface</string>
    <!-- Settings homepage entry summary. [CHAR LIMIT=NONE] -->
    <string name="settings_summary">Options for Glyph lights</string>
    <!-- Main switch: whether the strips are used at all. [CHAR LIMIT=48] -->
    <string name="pref_glyph_lights_title">Glyph lights</string>
    <!-- Settings item: how bright the strips are. [CHAR LIMIT=48] -->
    <string name="pref_brightness_title">Brightness level</string>
    <!-- Settings item: let the light around the phone set how bright the strips are. [CHAR LIMIT=48] -->
    <string name="pref_auto_brightness_title">Auto brightness</string>
    <!-- Settings item summary for auto brightness. [CHAR LIMIT=NONE] -->
    <string name="pref_auto_brightness_summary">Adjust Glyph brightness to the light around the phone</string>

    <!-- Banner on the settings while the strips are dark for quiet hours. [CHAR LIMIT=48] -->
    <string name="quiet_banner_title">Glyph lights are off for quiet hours</string>
    <!-- Banner summary when a schedule or Bedtime mode keeps the strips dark. [CHAR LIMIT=NONE] -->
    <string name="quiet_banner_schedule">They light again when your schedule ends.</string>
    <!-- Banner summary when Do Not Disturb keeps the strips dark. [CHAR LIMIT=NONE] -->
    <string name="quiet_banner_dnd">They light again when Do Not Disturb is off.</string>
    <!-- Banner summary when Battery Saver keeps the strips dark. [CHAR LIMIT=NONE] -->
    <string name="quiet_banner_battery_saver">They light again when Battery Saver is off.</string>
    <!-- Banner button: opens the quiet hours screen. [CHAR LIMIT=24] -->
    <string name="quiet_banner_action">Quiet hours</string>

    <!-- Settings category for how bright the strips are. [CHAR LIMIT=32] -->
    <string name="pref_category_brightness">Brightness</string>

    <!-- Settings category for what lights the strips on a call or a notification. [CHAR LIMIT=32] -->
    <string name="pref_category_alerts">Alerts</string>
    <!-- Settings item: the animation an incoming call rings with. [CHAR LIMIT=48] -->
    <string name="pref_call_animation_title">Call animation</string>
    <!-- Settings item summary for the call animation. [CHAR LIMIT=NONE] -->
    <string name="pref_call_animation_summary">Flash LEDs on incoming calls</string>
    <!-- Call screen main switch. [CHAR LIMIT=48] -->
    <string name="pref_call_animation_enable_title">Enable call animation</string>
    <!-- Call screen item: which animation to ring with. [CHAR LIMIT=48] -->
    <string name="pref_call_animation_pattern_title">Call pattern</string>
    <!-- Animation screens category: which animation to use, and trying it. [CHAR LIMIT=32] -->
    <string name="pref_category_animation">Animation</string>
    <!-- Animation screens button: plays the chosen animation on the glyphs once. [CHAR LIMIT=48] -->
    <string name="pref_animation_play_title">Play on Glyph</string>
    <!-- Notification screen category: which apps may light the glyphs. [CHAR LIMIT=32] -->
    <string name="pref_category_apps">Apps</string>

    <!-- Settings item: the animation a new notification plays. [CHAR LIMIT=48] -->
    <string name="pref_notification_animation_title">Notification animation</string>
    <!-- Settings item summary for the notification animation. [CHAR LIMIT=NONE] -->
    <string name="pref_notification_animation_summary">Flash LEDs on new notifications</string>
    <!-- Notification screen main switch. [CHAR LIMIT=48] -->
    <string name="pref_notification_animation_enable_title">Enable notification animation</string>
    <!-- Notification screen item: which animation to play. [CHAR LIMIT=48] -->
    <string name="pref_notification_animation_pattern_title">Notification pattern</string>
    <!-- Notification screen item: opens the list of apps that may light the strips. [CHAR LIMIT=48] -->
    <string name="pref_allowed_apps_title">Apps to allow</string>
    <!-- Settings item summary for the list of apps that may light the strips. [CHAR LIMIT=NONE] -->
    <string name="pref_allowed_apps_summary">Choose which apps play the notification animation</string>
    <!-- Apps to allow screen footer: what the list does. [CHAR LIMIT=NONE] -->
    <string name="allowed_apps_footer">A notification from an allowed app plays the animation once. Apps left off are ignored, and apps you install later are allowed to begin with.</string>
    <!-- Notification screen item: opens the list of apps that hold a glyph lit. [CHAR LIMIT=48] -->
    <string name="pref_essential_apps_title">Essential Notifications</string>
    <!-- Settings item summary for the list of apps that hold a glyph lit. [CHAR LIMIT=NONE] -->
    <string name="pref_essential_apps_summary">Choose which apps hold a glyph lit until they are read</string>
    <!-- Essential notifications screen footer: what the list does. [CHAR LIMIT=NONE] -->
    <string name="essential_apps_footer">Essential Glyph will be displayed until Essential notifications are read or dismissed</string>
    <!-- Notification screen summary when the user has not granted notification access. [CHAR LIMIT=NONE] -->
    <string name="notifications_access_required">Notification access is required to enable Glyph notifications</string>

    <!-- Settings category for what the strips show of the battery and the volume. [CHAR LIMIT=32] -->
    <string name="pref_category_indicators">Indicators</string>
    <!-- Settings item: show the charge level while plugged in. [CHAR LIMIT=48] -->
    <string name="pref_charging_meter_title">Charging meter</string>
    <!-- Settings item summary for the charging meter. [CHAR LIMIT=NONE] -->
    <string name="pref_charging_meter_summary">Wiggle for progress</string>
    <!-- Charging meter screen footer: what the feature does. [CHAR LIMIT=NONE] -->
    <string name="charging_meter_footer">Displays charging progression when charging with a cable.</string>
    <!-- Settings item: show an animation while charging another device. [CHAR LIMIT=48] -->
    <string name="pref_powershare_title">Reverse wireless charging</string>
    <!-- Settings item summary, and screen footer, for reverse charging. [CHAR LIMIT=NONE] -->
    <string name="pref_powershare_summary">Show an animation when reverse wireless charging is detected</string>

    <!-- Settings item: show the volume on the strips as it changes. [CHAR LIMIT=48] -->
    <string name="pref_volume_indicator_title">Volume indicator</string>
    <!-- Settings item summary for the volume indicator. [CHAR LIMIT=NONE] -->
    <string name="pref_volume_indicator_summary">Audio level at a glance</string>
    <!-- Volume screen footer: what the feature does. [CHAR LIMIT=NONE] -->
    <string name="volume_indicator_footer">Display the current volume level with the Glyph Interface when adjusting.</string>

    <!-- Settings category for what the device does by itself. [CHAR LIMIT=32] -->
    <string name="pref_category_gestures">Gestures</string>
    <!-- Settings item: silence the device while it lies face down. [CHAR LIMIT=48] -->
    <string name="pref_flip_to_glyph_title">Flip to Glyph</string>
    <!-- Settings item summary for Flip to Glyph. [CHAR LIMIT=NONE] -->
    <string name="pref_flip_to_glyph_summary">Silence on demand</string>
    <!-- Flip to Glyph screen footer: what the feature does. [CHAR LIMIT=NONE] -->
    <string name="flip_to_glyph_footer">For quiet focus, put the device with the Glyph Interface face up on a flat surface to trigger silent, lights-only notifications and calls.</string>

    <!-- Settings item: keep the strips dark at set times. [CHAR LIMIT=48] -->
    <string name="pref_schedule_title">Quiet hours</string>
    <!-- Settings item summary for quiet hours. [CHAR LIMIT=NONE] -->
    <string name="pref_schedule_summary">Keep the Glyph lights dark at bedtime or set times</string>
    <!-- Quiet hours category for when the strips are dark. [CHAR LIMIT=32] -->
    <string name="pref_category_timing">Timing</string>
    <!-- Quiet hours setting: what decides when the strips are dark. [CHAR LIMIT=48] -->
    <string name="pref_schedule_mode_title">Schedule</string>
    <!-- Quiet hours schedule: never. [CHAR LIMIT=48] -->
    <string name="schedule_mode_none">None</string>
    <!-- Quiet hours schedule: while Bedtime mode is on. [CHAR LIMIT=48] -->
    <string name="schedule_mode_bedtime">During Bedtime mode</string>
    <!-- Quiet hours schedule: between times the user sets. [CHAR LIMIT=48] -->
    <string name="schedule_mode_custom">At set times</string>
    <!-- Quiet hours item: opens the system's Bedtime mode settings. [CHAR LIMIT=48] -->
    <string name="pref_schedule_bedtime_title">Bedtime mode</string>
    <!-- Quiet hours item summary for Bedtime mode. [CHAR LIMIT=NONE] -->
    <string name="pref_schedule_bedtime_summary">Follows when Bedtime mode turns on</string>
    <!-- Quiet hours item: when the strips go dark. [CHAR LIMIT=48] -->
    <string name="pref_schedule_start_title">Start time</string>
    <!-- Quiet hours item: when the strips light again. [CHAR LIMIT=48] -->
    <string name="pref_schedule_end_title">End time</string>
    <!-- Quiet hours item: opens the screen that sets the times and days. [CHAR LIMIT=48] -->
    <string name="pref_schedule_hours_title">Set times</string>
    <!-- Quiet hours item summary: the times, then the days they run on. [CHAR LIMIT=NONE] -->
    <string name="schedule_hours_summary"><xliff:g example="10:00 PM" id="start">%1$s</xliff:g> to <xliff:g example="7:00 AM" id="end">%2$s</xliff:g>, <xliff:g example="Every day" id="days">%3$s</xliff:g></string>
    <!-- Quiet hours days summary when every day is chosen. [CHAR LIMIT=32] -->
    <string name="schedule_every_day">Every day</string>
    <!-- Quiet hours days summary when no day is chosen. [CHAR LIMIT=32] -->
    <string name="schedule_no_days">No days</string>
    <!-- Set times screen footer: what the times do. [CHAR LIMIT=NONE] -->
    <string name="schedule_hours_footer">The Glyph lights stay dark between these times, on the days you choose.</string>
    <!-- Quiet hours: how long the set times last, in hours and minutes. [CHAR LIMIT=32] -->
    <string name="schedule_duration"><xliff:g example="10" id="hours">%1$d</xliff:g> hr, <xliff:g example="20" id="minutes">%2$d</xliff:g> min</string>
    <!-- Quiet hours category for Do Not Disturb. [CHAR LIMIT=32] -->
    <string name="pref_category_schedule_dnd">Do Not Disturb</string>
    <!-- Quiet hours item: keep the strips dark while Do Not Disturb is on. [CHAR LIMIT=48] -->
    <string name="pref_schedule_dnd_title">Follow Do Not Disturb</string>
    <!-- Quiet hours item summary for following Do Not Disturb. [CHAR LIMIT=NONE] -->
    <string name="pref_schedule_dnd_summary">Keep the Glyph lights dark while Do Not Disturb is on</string>
    <!-- Quiet hours category for Battery Saver. [CHAR LIMIT=32] -->
    <string name="pref_category_schedule_battery_saver">Battery Saver</string>
    <!-- Quiet hours item: keep the strips dark while Battery Saver is on. [CHAR LIMIT=48] -->
    <string name="pref_schedule_battery_saver_title">Follow Battery Saver</string>
    <!-- Quiet hours item summary for following Battery Saver. [CHAR LIMIT=NONE] -->
    <string name="pref_schedule_battery_saver_summary">Keep the Glyph lights dark while Battery Saver is on</string>
    <!-- Quiet hours screen footer: what quiet hours do. [CHAR LIMIT=NONE] -->
    <string name="schedule_footer">Glyph lights stay dark during quiet hours, including for calls, notifications, and charging. If the Glyph torch is on, it turns off until quiet hours end.</string>
    <string-array name="schedule_mode_entries">
        <item>@string/schedule_mode_none</item>
        <item>@string/schedule_mode_bedtime</item>
        <item>@string/schedule_mode_custom</item>
    </string-array>
    <string-array name="schedule_mode_values" translatable="false">
        <item>none</item>
        <item>bedtime</item>
        <item>custom</item>
    </string-array>

    <!-- Settings category for what is left, which is quiet hours and music. [CHAR LIMIT=32] -->
    <string name="pref_category_more">More</string>
    <!-- Settings item: light the strips in time with what is playing. [CHAR LIMIT=48] -->
    <string name="pref_music_visualizer_title">Music visualization</string>
    <!-- Settings item summary for music visualization. [CHAR LIMIT=NONE] -->
    <string name="pref_music_visualizer_summary">Give life to the party</string>
    <!-- Music visualization screen footer: what the feature does. [CHAR LIMIT=NONE] -->
    <string name="music_visualizer_footer">The Glyph Interface lights up in sync to music played through the speakers.</string>

    <!-- Settings item: asks to add the screen's tile to Quick Settings. [CHAR LIMIT=48] -->
    <string name="pref_add_tile_title">Add to Quick Settings</string>
    <!-- Toast shown when the tile asked for is already in Quick Settings. [CHAR LIMIT=48] -->
    <string name="tile_already_added">Already in Quick Settings</string>

    <!-- Quick settings tile label: the strips. [CHAR LIMIT=32] -->
    <string name="tile_glyph_label">Glyph</string>
    <!-- Quick settings tile label: the strips as a torch. [CHAR LIMIT=32] -->
    <string name="tile_torch_label">Glyph torch</string>
    <!-- Quick settings tile label: the strips following the music. [CHAR LIMIT=32] -->
    <string name="tile_music_visualizer_label">Music visualizer</string>
    <!-- Spoken state of a quick settings tile that is on. [CHAR LIMIT=24] -->
    <string name="tile_on_content_description">On</string>
    <!-- Spoken state of a quick settings tile that is off. [CHAR LIMIT=24] -->
    <string name="tile_off_content_description">Off</string>

