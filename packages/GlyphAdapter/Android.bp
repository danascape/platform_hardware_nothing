aidl_interface {
    name: "com.nothing.thirdparty",
    unstable: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/com/nothing/thirdparty/IGlyphService.aidl",
    ],
}

android_app {
    name: "GlyphAdapter",
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    srcs: [
        "src/**/*.kt",
    ],

    static_libs: [
        "com.nothing.thirdparty-java",
    ],
}
