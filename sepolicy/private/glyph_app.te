type glyph_app, domain, coredomain, mlstrustedsubject;

app_domain(glyph_app)

# Allow ParanoidGlyph to manage its data.
allow glyph_app system_app_data_file:dir create_dir_perms;
allow glyph_app system_app_data_file:{ file lnk_file } create_file_perms;

# Allow ParanoidGlyph to access system services.
allow glyph_app {
  app_api_service
  audioserver_service
  radio_service
}:service_manager find;

# Allow ParanoidGlyph to read the reverse charging state.
r_dir_file(glyph_app, sysfs_powershare)
