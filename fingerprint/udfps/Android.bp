cc_defaults {
    name: "libudfpshandler.nothing_defaults",
    defaults: ["nothing_hardware_biometrics_config_default"],
    stem: "libudfpshandler",
    vendor: true,
    shared_libs: [
        "libbase",
    ],
    header_libs: [
        "nothingfingerprint_headers",
    ],
}

cc_library_shared {
    name: "libudfpshandler.Spacewar",
    enabled: select(soong_config_variable("NOTHING_BIOMETRICS_FINGERPRINT", "UDFPS_HANDLER"), {
        "Spacewar": true,
        default: false,
    }),
    defaults: ["libudfpshandler.nothing_defaults"],
    srcs: ["Spacewar.cpp"],
}
